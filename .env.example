FB_VERIFY_TOKEN=replace_with_a_long_random_string
PAGE_ACCESS_TOKEN=replace_with_your_facebook_page_access_token
# Token Marketing API riêng; không dùng chung token Messenger phía trên
FB_MARKETING_ACCESS_TOKEN=replace_with_a_token_that_has_ads_read
FB_AD_ACCOUNT_ID=act_123456789
GRAPH_API_VERSION=v26.0
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-6-luna
# Messenger chạy kịch bản hình + video nếu có + giá + xin số đo; nhận số đo thì nhường nhân viên.
# MESSENGER_MODE cũ không còn điều khiển luồng Messenger.
SUPABASE_URL=https://dnpigfdoyywvahnxuoei.supabase.co
SUPABASE_SECRET_KEY=replace_with_supabase_secret_key
# Messenger không tự tạo đơn. FB_APP_SECRET enables Meta webhook verification.
AUTO_ORDERS_ENABLED=false
FB_APP_SECRET=
# Required for changing order status or Human reset of product introductions.
# Viewing orders does not ask for a code.
ORDERS_ADMIN_TOKEN=
